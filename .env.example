# Pflicht — mit echten Werten in .env kopieren (nicht committen)
SECRET_KEY=bitte-langen-zufallswert-setzen
FERNET_KEY=hier-mit-fernet-generate-key-erzeugen
DATABASE_URL=sqlite:///stundenplan.db

# open = jeder kann sich registrieren, invite = INVITE_CODE noetig, admin = zu
REGISTRATION_MODE=invite
INVITE_CODE=

# Mail (Bestaetigungslinks + Passwort-Reset). Ohne funktionierenden SMTP kann
# sich niemand registrieren oder sein Passwort zuruecksetzen.
MAIL_SERVER=smtp.example.org
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.org

# Cookies (in Produktion hinter HTTPS true)
SESSION_COOKIE_SECURE=true

# Zeitzone des Unterrichts. Der Server laeuft auf UTC — ohne das laege die
# Jetzt-Ansicht im Sommer zwei Stunden zurueck.
TIMEZONE=Europe/Berlin

# Laufzeiten weiterer Bildungsgaenge in Jahren, als JSON. Ergaenzt die im Code
# vorbelegten (FI 3, FIT/FET/FMT 4). Ein Kuerzel ohne Eintrag wird nie
# automatisch stillgelegt — im Zweifel laeuft die Klasse weiter.
# Beispiel: KLASSENLAUFZEITEN={"AVV": 1, "BFA": 2}
KLASSENLAUFZEITEN=

# Socket-Timeout in Sekunden fuer SMTP- und WebUntis-Verbindungen
NETWORK_TIMEOUT=20

# Rate-Limit-Speicher: memory:// ist korrekt, solange gunicorn mit genau EINEM
# Worker laeuft (so wie deploy/stundenplan-web.service es startet). Bei mehreren
# Workern zaehlt sonst jeder Prozess separat — dann redis://localhost:6379 setzen.
RATELIMIT_STORAGE_URI=memory://
